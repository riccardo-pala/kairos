{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kairos — Ollama",
      "type": "debugpy",
      "request": "launch",
      "module": "kairos",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "args": [
        "--model", "qwen3:8b",
        "--language", "it",
        "--timezone", "Europe/Rome",
        "--think",
        "--debug-draft-json",
        "--debug-model-io",
        "--debug-validation"
      ]
    },
    {
      "name": "Kairos API + playground",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "DATABASE_URL": "postgresql://kairos:kairos-local@localhost:5432/kairos",
        "PLAYGROUND_DEBUG_API_LOGS": "true",
        "PLAYGROUND_DEBUG_CONNECTOR_LOGS": "true",
        "PLAYGROUND_DEBUG_INTERNAL_LOGS": "true"
      },
      "args": [
        "kairos.api:app",
        "--host", "127.0.0.1",
        "--port", "8000",
        "--no-access-log"
      ]
    }
  ]
}
